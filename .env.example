# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and read only on the server by src/app/api/contact/route.ts.

# n8n "test" webhook — only live while its workflow is open in the n8n
# editor. Used automatically when NODE_ENV=development (i.e. `next dev`).
N8N_WEBHOOK_URL_DEV=

# n8n "production" webhook — live once the workflow is activated. Used
# automatically when NODE_ENV=production (a production build/deploy).
N8N_WEBHOOK_URL_PROD=
